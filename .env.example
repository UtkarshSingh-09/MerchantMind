# Environment Variables - Copy to .env and fill in values
# DO NOT commit .env to git!

# === Database ===
POSTGRES_USER=merchantmind
POSTGRES_PASSWORD=merchantmind_dev
POSTGRES_DB=merchantmind
DATABASE_URL=postgresql+asyncpg://merchantmind:merchantmind_dev@postgres:5432/merchantmind

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Groq API ===
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# === Razorpay (Test Mode) ===
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# === WhatsApp Business API (Meta) ===
WHATSAPP_ACCESS_TOKEN=your_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_verify_token_here

# === App ===
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-random-secret
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# === CORS ===
CORS_ORIGINS=http://localhost:3000,http://localhost:80
